<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <!-- Keep the test project and the React app out of the API build. -->
  <ItemGroup>
    <Compile Remove="tests/**;frontend/**" />
    <Content Remove="tests/**;frontend/**" />
    <None Remove="tests/**;frontend/**" />
  </ItemGroup>

</Project>
